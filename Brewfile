# The terminal, font and command-line tools this shell configuration uses.
# Install them all with `brew bundle` from the repository root.

# The shell prompt.
brew "starship"
# Searchable shell history on Ctrl-R and the up arrow.
brew "atuin"
# Jumping to recent directories with `z` and `zi`.
brew "zoxide"
# Fuzzy selection of files, directories and commands.
brew "fzf"
# Syntax-highlighted file viewing.
brew "bat"
# File listings and directory trees.
brew "eza"
# Fast file search.
brew "fd"
# Fast text search with `rg`.
brew "ripgrep"
# The GitHub command line.
brew "gh"
# GNU core utilities used by the aliases.
brew "coreutils"
# Grey suggestions from earlier commands as you type.
brew "zsh-autosuggestions"
# Short command examples with `tldr`.
brew "tlrc"

# The terminal app.
cask "ghostty"
# The Nerd Font that supplies the prompt's symbols.
cask "font-jetbrains-mono-nerd-font"
