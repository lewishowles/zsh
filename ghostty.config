# Typography
font-family = JetBrainsMono Nerd Font
font-size = 15

# Stop sessions taking over shift
mouse-shift-capture = never

# Allow alt
macos-option-as-alt = left

# Stop annoying popups
confirm-close-surface = false

# Breathing room around terminal content
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# Preserve useful context when reopening Ghostty
window-save-state = always

# Keep the cursor easy to locate
cursor-style = bar
cursor-style-blink = false

# Reduce visual noise
mouse-hide-while-typing = true

# Make inactive panes distinguishable without making them unreadable
unfocused-split-opacity = 0.88

# Allow shell integrations to update titles and working directories
shell-integration = zsh
shell-integration-features = cursor,sudo,no-title

# Attempt to improve keyboard selection
keybind = shift+left=adjust_selection:left
keybind = shift+right=adjust_selection:right
keybind = shift+up=adjust_selection:up
keybind = shift+down=adjust_selection:down
keybind = shift+home=adjust_selection:beginning_of_line
keybind = shift+end=adjust_selection:end_of_line
keybind = cmd+c=copy_to_clipboard