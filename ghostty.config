# Typography
font-family = JetBrainsMono Nerd Font
font-size = 15

macos-option-as-alt = left

# Stop annoying popups
confirm-close-surface = false

# Breathing room around terminal content
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true

# Preserve useful context when reopening Ghostty
window-save-state = always

# Keep the cursor easy to locate
cursor-style = bar
cursor-style-blink = false

# Reduce visual noise
mouse-hide-while-typing = true

# Make inactive panes distinguishable without making them unreadable
unfocused-split-opacity = 0.88

# Allow shell integrations to update titles and working directories
shell-integration = zsh
shell-integration-features = cursor,sudo,no-title

# Comfortable scrollback
scrollback-limit = 100000
